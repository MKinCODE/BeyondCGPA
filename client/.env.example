# BeyondCGPA Frontend Environment Configuration

# Production API URL (Render backend):
# In Vercel Environment Variables, name this: BACKEND_URL
# Example: https://beyondcgpa.onrender.com (or your Render service URL)
BACKEND_URL=

# Local development:
# Leave empty or commented to automatically use the Vite proxy (-> http://localhost:5000)
# BACKEND_URL=

# Google OAuth 2.0 Client ID (Optional for local review; required for Google GIS sign-in)
# Can also be automatically discovered from backend diagnostics
# In Vercel Environment Variables, name this: GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

